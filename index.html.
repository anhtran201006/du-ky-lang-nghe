            const seaBridgeMat = new THREE.MeshStandardMaterial({
                color: 0x38bdf8,
                emissive: 0x00e5ff,
                emissiveIntensity: 0.65,
                roughness: 0.25
            });
            const chevronMat = new THREE.MeshStandardMaterial({
                color: 0xffffff,
                emissive: 0xfef08a,
                emissiveIntensity: 0.9
            });

            // Flat y-scale factor so TubeGeometry becomes a wafer-thin flat road ribbon hugging the terrain
            const flatScaleY = 0.065;
            const total = BOARD_TILES.length;

            // Connect ALL 32 tiles in a complete closed loop: i -> (i + 1) % 32 (including #31 Tân Cương directly into #0 Hà Nội!)
            for (let i = 0; i < total; i++) {
                const curr = BOARD_TILES[i];
                const next = BOARD_TILES[(i + 1) % total];
                const isSeaCrossing = (i === 19 || i === 20 || i === 2 || i === 3 || i === 10 || i === 11);

                const p1 = new THREE.Vector3(curr.mapX, (curr.elevation + 0.14) / flatScaleY, curr.mapZ);
                const p2 = new THREE.Vector3(next.mapX, (next.elevation + 0.14) / flatScaleY, next.mapZ);
                const mid = new THREE.Vector3().lerpVectors(p1, p2, 0.5);

                // Curve slightly outward on coastal/island crossings so the closed loop looks graceful and never overlaps
                const dx = next.mapX - curr.mapX;
                const dz = next.mapZ - curr.mapZ;
                if (i === 19) {
                    // Cà Mau (#19) -> Đảo Phú Quốc (#20)
                    mid.x -= 0.65;
                    mid.z += 0.55;
                } else if (i === 20) {
                    // Đảo Phú Quốc (#20) -> Chợ Nổi Cái Răng (#21)
                    mid.x -= 0.45;
                    mid.z -= 0.35;
                } else {
                    mid.x += -dz * 0.06;
                    mid.z += dx * 0.06;
                }
                mid.y = (Math.max(curr.elevation, next.elevation) + 0.16) / flatScaleY;

                const segCurve = new THREE.QuadraticBezierCurve3(p1, mid, p2);

                const outerRibbon = new THREE.Mesh(
                    new THREE.TubeGeometry(segCurve, 20, 0.12, 8, false),
                    isSeaCrossing ? seaBridgeMat : trimMat
