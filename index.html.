            scene.add(demMesh);
            // 3. Flat, Low-Profile National Border Ribbon (Mảnh và dẹt ôm sát viền bản đồ)
            const borderPoints3D = VIETNAM_BORDER_LONLAT.map(([lon, lat]) => {
                const { x, z } = geoToBoardXZ(lon, lat);
                const h = sampleVietnamElevation(lon, lat);
                return new THREE.Vector3(x, (0.39 + h * 0.92) / 0.25, z);
