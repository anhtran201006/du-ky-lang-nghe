        // Active Skill Activation from Bottom Hand Bar (Works for any active Human Player!)
        function activateUserSkillCard(skillArrayIndex) {
            const user = PLAYERS[gameState.currentPlayerIdx];
            if (!user || user.isNPC || gameState.isBusy) return;
            const sId = user.skills[skillArrayIndex];
