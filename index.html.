                { lon: 107.88, lat: 20.85, rx: 0.95, rz: 0.85, h: 0.42, color: 0x16a34a }, // Vịnh Hạ Long - Vân Đồn (Ô #3)
                { lon: 109.25, lat: 14.55, rx: 0.82, rz: 0.75, h: 0.40, color: 0x16a34a }  // Đảo Lý Sơn (Ô #11)
            ];
            islands.forEach(isl => {
                const { x, z } = geoToBoardXZ(isl.lon, isl.lat);
                // Golden sandy beach rim around each island
                const beachGeo = new THREE.CylinderGeometry(isl.rx * 0.96, isl.rx * 1.12, 0.16, 24);
