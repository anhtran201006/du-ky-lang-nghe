                playSFX('card');
                addLog(`🐎 <b>${user.shortName}</b> đã kích hoạt <b>"Tốc Hành Xuyên Việt"</b>: Được đổ xúc xắc 2 lần liên tiếp!`, '🐎', 'text-amber-300 font-semibold');
                showBanner('Đã kích hoạt đổ xúc xắc 2 lần!', '🐎', 1800);
