                playSFX('card');
                addLog(`🏷️ <b>${user.shortName}</b> đã kích hoạt <b>"Thánh Mặc Cả"</b>: Giảm 30% giá mua Ô Tài sản trong lượt này!`, '🏷️', 'text-amber-300 font-semibold');
