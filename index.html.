        function addLog(message, icon = '📜', highlightClass = 'text-amber-100') {
            const logEl = document.getElementById('game-log');
            const entry = document.createElement('div');
            entry.className = `p-1.5 rounded-lg bg-black/25 border-l-2 border-amber-500 ${highlightClass}`;
            entry.innerHTML = `<span class="mr-1">${icon}</span>${message}`;
            logEl.prepend(entry);
        }

        function showBanner(text, icon = '🎲', duration = 2200) {
            const banner = document.getElementById('action-banner');
            document.getElementById('banner-icon').textContent = icon;
            document.getElementById('banner-text').textContent = text;
            banner.classList.remove('opacity-0', 'scale-95');
            banner.classList.add('opacity-100', 'scale-100');
            clearTimeout(banner._timer);
            banner._timer = setTimeout(() => {
                banner.classList.remove('opacity-100', 'scale-100');
                banner.classList.add('opacity-0', 'scale-95');
            }, duration);
        }

        /*************************************************************************
         * 7. CORE GAMEPLAY LOOP: DICE ROLL, PAWN HOPPING, TILE RESOLUTION & AI
         *************************************************************************/
        function sleep(ms) {
            const scaledMs = Math.max(80, Math.round(ms / (gameState.speedMultiplier || 1)));
            return new Promise(resolve => setTimeout(resolve, scaledMs));
        }

        async function handleUserRollClick() {
            const currP = PLAYERS[gameState.currentPlayerIdx];
            if (gameState.isBusy || !currP || currP.isNPC || gameState.gameEnded) return;
            await executePlayerTurn(currP);
        }

        async function executePlayerTurn(player) {
            if (player.bankrupt || gameState.gameEnded) {
                advanceToNextTurn();
                return;
            }

            gameState.isBusy = true;
            updateAllHUD();

            // NPC pre-roll smart check: if NPC holds TOC_HANH, activate it!
            if (player.isNPC && player.skills.includes('TOC_HANH') && !player.extraRollActive) {
                const sIdx = player.skills.indexOf('TOC_HANH');
                player.skills.splice(sIdx, 1);
                player.extraRollActive = true;
                addLog(`<b>${player.shortName}</b> tung Thẻ Bản Lĩnh <b>"Tốc Hành Xuyên Việt"</b> để được đổ xúc xắc 2 lần liên tiếp!`, '🐎', 'text-amber-300');
                showBanner(`${player.shortName} kích hoạt Thẻ Tốc Hành!`, '🐎', 1600);
                await sleep(1100);
            }

            // 1. Roll 3D Wooden Dice
            const diceValue = Math.floor(Math.random() * 6) + 1;
            playSFX('dice');
            showBanner(`${player.shortName} đang tung xúc xắc gỗ...`, '🎲', 1500);

            await animate3DDiceRoll(diceValue);
            updateDice2DIcon(diceValue);

            addLog(`<b>${player.shortName}</b> tung xúc xắc được <b>${diceValue} nút</b>.`, '🎲');
            showBanner(`${player.shortName} đi ${diceValue} bước!`, '🎲', 1600);

            // 2. Move Pawn Step-by-Step Clockwise
            await movePawnSteps(player, diceValue);

            // 3. Inspect landed tile & Resolve Interaction
            const landedTile = BOARD_TILES[player.position];
            updateTileInspector(player.position);
            await sleep(450);

            await resolveTileTouchpoint(player, landedTile);

            // 4. Check if player activated Extra Roll ("Tốc hành")
            if (player.extraRollActive && !player.bankrupt && !gameState.gameEnded) {
                player.extraRollActive = false;
                addLog(`Nhờ thẻ <b>Tốc Hành</b>, <b>${player.shortName}</b> được tiếp tục tung xúc xắc thêm 1 lượt!`, '🐎', 'text-amber-300');
                showBanner(`${player.shortName} đi tiếp lượt thứ 2!`, '🐎', 1800);
                await sleep(1200);
                await executePlayerTurn(player);
                return;
            }

            advanceToNextTurn();
        }

        function animate3DDiceRoll(resultValue) {
            return new Promise(resolve => {
                const spd = gameState.speedMultiplier || 1;
                const faceRotations = {
                    1: { x: 0, z: Math.PI / 2 },
                    2: { x: 0, z: -Math.PI / 2 },
                    3: { x: 0, z: 0 },
                    4: { x: Math.PI, z: 0 },
                    5: { x: -Math.PI / 2, z: 0 },
                    6: { x: Math.PI / 2, z: 0 }
                };
                const target = faceRotations[resultValue];

                gsap.timeline({ onComplete: resolve })
                    .to(diceMesh.position, { y: 5.2, x: -7.2 + (Math.random() - 0.5) * 1.6, z: -1.5 + (Math.random() - 0.5) * 1.6, duration: 0.35 / spd, ease: 'power2.out' }, 0)
                    .to(diceMesh.rotation, { x: Math.PI * 4 + target.x, y: Math.PI * 2, z: Math.PI * 4 + target.z, duration: 0.75 / spd, ease: 'power2.out' }, 0)
                    .to(diceMesh.position, { y: 1.1, duration: 0.4 / spd, ease: 'bounce.out' }, 0.35 / spd);
            });
        }

        function updateDice2DIcon(val) {
            const names = ['one', 'two', 'three', 'four', 'five', 'six'];
            document.getElementById('dice-2d-preview').innerHTML = `<i class="fa-solid fa-dice-${names[val - 1]}"></i>`;
        }

        async function movePawnSteps(player, steps) {
            const pawn = playerPawns[player.id];
            const off = getPlayerPawnOffset(player.id);
            const spd = gameState.speedMultiplier || 1;

            for (let s = 0; s < steps; s++) {
                player.position = (player.position + 1) % BOARD_TILES.length;
                const targetTile = BOARD_TILES[player.position];

                if (gameState.autoFollowCamera) {
                    gsap.to(controls.target, {
                        x: targetTile.mapX * 0.65,
                        y: targetTile.elevation * 0.5,
                        z: targetTile.mapZ * 0.65,
                        duration: 0.26 / spd,
                        ease: 'power1.out'
                    });
                }

                playSFX('step');
                {
                    const ddx = targetTile.mapX + off.dx - pawn.position.x, ddz = targetTile.mapZ + off.dz - pawn.position.z;
                    const cur = pawn.userData.faceY || 0, tgt = Math.atan2(ddx, ddz);
                    const dl = ((tgt - cur + Math.PI) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2) - Math.PI;
                    gsap.to(pawn.userData, { faceY: cur + dl, duration: 0.15 / spd });
                }
                await new Promise(res => {
                    gsap.timeline({ onComplete: res })
                        .to(pawn.position, {
                            x: targetTile.mapX + off.dx,
                            z: targetTile.mapZ + off.dz,
                            duration: 0.28 / spd,
                            ease: 'power1.inOut'
                        }, 0)
                        .to(pawn.position, { y: targetTile.elevation + 1.55, duration: 0.14 / spd, ease: 'power1.out' }, 0)
                        .to(pawn.position, { y: targetTile.elevation + 0.25, duration: 0.14 / spd, ease: 'bounce.out' }, 0.14 / spd);
                });

                // Check Passing or Landing on Ô Xuất Phát (Tile 0 - Thăng Long Hà Nội) -> Receive 300đ Salary!
                if (player.position === 0) {
                    player.cash += 300;
                    playSFX('coin');
                    addLog(`🏯 <b>${player.shortName}</b> hoàn thành hành trình xuyên Việt qua <b>Thăng Long - Hà Nội</b>, nhận Tiền Lương <b>+300 đồng</b>!`, '💰', 'text-emerald-300 font-semibold');
                    showBanner(`${player.shortName} nhận Lương +300 đồng!`, '💰', 1800);
                    updateAllHUD();
                    await sleep(500);
                }
            }
        }

        /*************************************************************************
         * 8. FOUR TOUCHPOINT SCENARIOS (LUẬT CHƠI CHUẨN TÀI LIỆU)
         *************************************************************************/
        async function resolveTileTouchpoint(player, tile) {
            if (tile.type === 'START') {
                // Already awarded +300đ upon stepping onto index 0
                await sleep(500);
                return;
            }

            // CASE 1 & 2: PROPERTY TILE (Ô TÀI SẢN)
            if (tile.type === 'PROPERTY') {
                const ownerId = gameState.propertyOwners[tile.index];

                // Case 1: Unowned Property
                if (ownerId === undefined) {
                    await handleUnownedProperty(player, tile);
                }
                // Case 2: Owned by Another Player -> Visitor Situation!
                else if (ownerId !== player.id) {
                    await handleVisitorOnOwnedProperty(player, tile, PLAYERS[ownerId]);
                }
                // Owned by Self
                else {
                    addLog(`<b>${player.shortName}</b> ghé thăm cơ sở <b>${tile.name}</b> của chính mình.`, '🏡');
                    await sleep(600);
                }
                return;
            }

            // CASE 3: TOOL SHOP (Ô TRẠM DỪNG / CỬA HÀNG CÔNG CỤ)
            if (tile.type === 'SHOP') {
                await handleToolShopVisit(player, tile);
                return;
            }

            // CASE 4A: Ô BIẾN ĐỘNG (!)
            if (tile.type === 'BIEN_DONG') {
                await handleBienDongDraw(player);
                return;
            }

            // CASE 4B: Ô BẢN LĨNH (?)
            if (tile.type === 'BAN_LINH') {
                await handleBanLinhDraw(player);
                return;
            }
        }

        // --- CASE 1: UNOWNED PROPERTY ---
        async function handleUnownedProperty(player, tile) {
            // Check if player holds Thánh Mặc Cả
            const hasBargainCard = player.skills.includes('THANH_MAC_CA');
            const discountedPrice = Math.round(tile.price * 0.7);

            if (player.isNPC) {
                await sleep(900);
                let finalPrice = tile.price;

                // Autonomous NPC Decision: Use "Thánh Mặc Cả" if available
                if (hasBargainCard && player.cash >= discountedPrice + 60) {
                    const sIdx = player.skills.indexOf('THANH_MAC_CA');
                    player.skills.splice(sIdx, 1);
                    finalPrice = discountedPrice;
                    addLog(`<b>${player.shortName}</b> tung thẻ <b>"Thánh Mặc Cả"</b> giảm 30% giá mua ${tile.name} còn <b>${finalPrice} đồng</b>!`, '🏷️', 'text-amber-300');
                }

                // NPC buys if cash after purchase >= 100đ (or >= 60đ with discount)
                if (player.cash - finalPrice >= 80) {
                    completePropertyPurchase(player, tile, finalPrice);
                    await sleep(1000);
                } else {
                    addLog(`<b>${player.shortName}</b> cân nhắc dòng tiền và quyết định chưa mua <b>${tile.name}</b>.`, '🤔');
                    showBanner(`${player.shortName} giữ tiền mặt dự phòng`, '🤔', 1400);
                    await sleep(800);
                }
                return;
            }

            // User Modal for Unowned Property
            const currentPrice = player.discountActive ? discountedPrice : tile.price;
            const canAfford = player.cash >= currentPrice;
            const canAffordWithCard = hasBargainCard && player.cash >= discountedPrice;

            return new Promise(resolve => {
                openModal(`
                    <div class="text-center">
                        <span class="px-3 py-1 rounded-full bg-amber-800 text-amber-100 text-xs font-extrabold uppercase tracking-wider">Ô Tài Sản Vô Chủ • ${tile.region}</span>
                        <div class="text-5xl my-3">${tile.icon}</div>
                        <h2 class="font-serif-vn font-extrabold text-2xl text-amber-950">${tile.name}</h2>
                        <p class="text-xs text-amber-900/80 mt-1">Đầu tư sở hữu di sản làng nghề và dựng mô hình kiến trúc 3D trên bàn cờ!</p>

                        <div class="bg-amber-900/10 border border-amber-800/30 rounded-2xl p-3.5 my-4 text-left space-y-2 text-xs">
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-amber-900">Giá trị đầu tư:</span>
                                <span class="font-black text-base text-emerald-800">${currentPrice} đồng ${player.discountActive ? '(Đã giảm 30%)' : ''}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-amber-900">Phí dịch vụ thu về:</span>
                                <span class="font-bold text-red-700">${tile.rent} đồng / lượt khách</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-semibold text-amber-900">Công cụ yêu cầu:</span>
                                <span class="font-bold text-teal-900">${tile.toolSpec}</span>
                            </div>
                            <div class="pt-1.5 border-t border-amber-800/20 italic text-amber-950">
                                <b>Tình huống trải nghiệm:</b> "${tile.situation}"
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-2.5 justify-center mt-4">
                            ${hasBargainCard && !player.discountActive ? `
                                <button id="modal-btn-bargain" class="bg-amber-500 hover:bg-amber-400 text-amber-950 font-extrabold px-4 py-2.5 rounded-xl border-2 border-amber-700 text-xs shadow">
                                    🏷️ Dùng "Thánh Mặc Cả" (Mua giá ${discountedPrice}đ)
                                </button>
                            ` : ''}
                            <button id="modal-btn-buy" ${canAfford ? '' : 'disabled'} class="wood-btn px-5 py-2.5 rounded-xl font-extrabold text-sm flex-1">
                                💰 Đầu Tư Mua Đất (${currentPrice}đ)
                            </button>
                            <button id="modal-btn-pass" class="bg-stone-300 hover:bg-stone-400 text-stone-800 font-bold px-4 py-2.5 rounded-xl text-sm">
                                Bỏ Qua
                            </button>
                        </div>
                    </div>
                `);

                const bargainBtn = document.getElementById('modal-btn-bargain');
                if (bargainBtn) {
                    bargainBtn.onclick = () => {
                        if (player.cash < discountedPrice) return;
                        const sIdx = player.skills.indexOf('THANH_MAC_CA');
                        if (sIdx > -1) player.skills.splice(sIdx, 1);
                        closeModal();
                        completePropertyPurchase(player, tile, discountedPrice);
                        resolve();
                    };
                }

