        /*************************************************************************
         * 10. TURN ADVANCEMENT, ROTATING CASHIER & 45-MINUTE TIMER (5 PLAYERS MAX)
         *************************************************************************/
        async function advanceToNextTurn() {
            if (gameState.gameEnded) return;
            if (checkVictory()) return;

            // Decrement temporary buff counters
            if (gameState.toolPriceInflationTurns > 0) gameState.toolPriceInflationTurns--;
            PLAYERS.forEach(p => {
                if (p.doubleRentTurns > 0) p.doubleRentTurns--;
            });

            gameState.turnCount++;

            // Find next active, non-bankrupt player among up to 5 slots
            let nextIdx = (gameState.currentPlayerIdx + 1) % PLAYERS.length;
            let loopGuard = 0;
            while ((!PLAYERS[nextIdx].active || PLAYERS[nextIdx].bankrupt) && loopGuard < PLAYERS.length + 1) {
                nextIdx = (nextIdx + 1) % PLAYERS.length;
                loopGuard++;
            }

            // Check if a full round completed
            if (nextIdx <= gameState.currentPlayerIdx) {
                gameState.round++;
                // Rotate Cashier Role ("Luân phiên Thủ quỹ Ngân hàng mỗi vòng")
                gameState.cashierIdx = (gameState.cashierIdx + 1) % PLAYERS.length;
                let cGuard = 0;
                while ((!PLAYERS[gameState.cashierIdx].active || PLAYERS[gameState.cashierIdx].bankrupt) && cGuard < PLAYERS.length + 1) {
                    gameState.cashierIdx = (gameState.cashierIdx + 1) % PLAYERS.length;
                    cGuard++;
                }
                addLog(`⚖️ Bắt đầu <b>Vòng ${gameState.round}</b>! Vai trò <b>Thủ Quỹ Ngân Hàng</b> được luân chuyển cho <b>${PLAYERS[gameState.cashierIdx].shortName}</b>.`, '⚖️', 'text-amber-300 font-semibold');
            }

            gameState.currentPlayerIdx = nextIdx;
            gameState.isBusy = false;
            updateAllHUD();

            const nextPlayer = PLAYERS[nextIdx];
            if (nextPlayer.isNPC && !gameState.gameEnded) {
                gameState.isBusy = true;
                updateAllHUD();
                await sleep(1100);
                await executePlayerTurn(nextPlayer);
            } else {
                showBanner(`Đến lượt của ${nextPlayer.shortName}! Hãy tung xúc xắc gỗ`, '🎲', 2200);
            }
        }

        function start45MinTimer() {
            setInterval(() => {
                if (gameState.gameEnded) return;
                gameState.remainingSeconds--;
                if (gameState.remainingSeconds <= 0) {
                    gameState.remainingSeconds = 0;
                    finishGameAndAudit('Đã hết 45 phút thời gian quy định của ván cờ!');
                }
                const m = String(Math.floor(gameState.remainingSeconds / 60)).padStart(2, '0');
                const s = String(gameState.remainingSeconds % 60).padStart(2, '0');
                document.getElementById('game-timer').textContent = `${m}:${s}`;
            }, 1000);
        }

