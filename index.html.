                    new THREE.MeshStandardMaterial({ color: 0xfde68a, roughness: 0.65 })
                );
                beachMesh.position.set(x, 0.08, z);
                scene.add(beachMesh);

                const islGeo = new THREE.CylinderGeometry(isl.rx * 0.78, isl.rx * 0.95, isl.h, 24);
                islGeo.scale(1, 1, isl.rz / isl.rx);
                const islMesh = new THREE.Mesh(
                    islGeo,
                    new THREE.MeshStandardMaterial({ color: isl.color, roughness: 0.65 })
                );
                islMesh.position.set(x, isl.h / 2, z);
                islMesh.castShadow = true;
                islMesh.receiveShadow = true;
                scene.add(islMesh);
            });

            // Sync all 32 BOARD_TILES coordinates & elevations to sit flush on the 3D Terrain & Islands
            BOARD_TILES.forEach((tile) => {
                const { x, z } = geoToBoardXZ(tile.lon, tile.lat);
                const isIslandTile = tile.index === 3 || tile.index === 11 || tile.index === 20;
                const h = isIslandTile ? 0.12 : sampleVietnamElevation(tile.lon, tile.lat);
                tile.mapX = x;
                tile.mapZ = z;
                tile.elevation = 0.36 + h * 0.92;
            });
        }

