                ...handOwner.skills.map((sId, i) => {
                    const card = BAN_LINH_CARDS.find(c => c.id === sId) || BAN_LINH_CARDS[0];
                    const canClickNow = isHumanTurnNow && !gameState.isBusy && sId !== 'VE_VIP';
                    return `
                        <button onclick="activateUserSkillCard(${i})" ${canClickNow ? '' : 'disabled'}
