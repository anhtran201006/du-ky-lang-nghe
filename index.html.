                outerRibbon.scale.y = flatScaleY;

                const innerRibbon = new THREE.Mesh(
                    new THREE.TubeGeometry(segCurve, 20, 0.078, 8, false),
                    cobbleMat
                );
                innerRibbon.scale.y = flatScaleY;
                innerRibbon.position.y += 0.008;
                scene.add(outerRibbon, innerRibbon);

                // Direction Arrow Plaque at the midpoint of every segment
                const worldP1 = new THREE.Vector3(curr.mapX, curr.elevation + 0.15, curr.mapZ);
                const worldP2 = new THREE.Vector3(next.mapX, next.elevation + 0.15, next.mapZ);
                const worldMid = new THREE.Vector3(mid.x, mid.y * flatScaleY + 0.025, mid.z);

