        // Scheduled Acoustic Note Player (Triggered at exact audioCtx time `when`)
        function scheduleAcousticInstrument(when, midi, duration, inst = 'VIOLIN', vol = 0.08, slideFromMidi = null) {
            if (!audioCtx) return;
            const freq = midiToFreq(midi);
            const osc = audioCtx.createOscillator();
            const osc2 = audioCtx.createOscillator();
            const bodyFilter = audioCtx.createBiquadFilter();
            const env = audioCtx.createGain();

            if (customPeriodicWaves[inst]) {
                osc.setPeriodicWave(customPeriodicWaves[inst]);
                osc2.setPeriodicWave(customPeriodicWaves[inst]);
            } else {
                osc.type = 'triangle';
                osc2.type = 'sine';
            }

            // Natural Vibrato LFO delayed slightly like a real string/wind player
            const lfo = audioCtx.createOscillator();
            const lfoGain = audioCtx.createGain();
            lfo.frequency.setValueAtTime(inst === 'ERHU' ? 6.2 : 5.4, when);
            lfoGain.gain.setValueAtTime(0.01, when);
            lfoGain.gain.linearRampToValueAtTime(inst === 'ERHU' ? 8.5 : (inst === 'FLUTE' ? 3.2 : 4.5), when + Math.min(0.18, duration * 0.45));
            lfo.connect(lfoGain);
            lfoGain.connect(osc.frequency);
            lfoGain.connect(osc2.frequency);

            // Instrument Wooden Body Formant Filter
            if (inst === 'ERHU') {
                bodyFilter.type = 'peaking';
                bodyFilter.frequency.setValueAtTime(1420, when);
                bodyFilter.Q.setValueAtTime(2.6, when);
                bodyFilter.gain.setValueAtTime(7, when);
            } else if (inst === 'OBOE') {
                bodyFilter.type = 'bandpass';
                bodyFilter.frequency.setValueAtTime(1180, when);
                bodyFilter.Q.setValueAtTime(1.6, when);
            } else {
                bodyFilter.type = 'lowpass';
                bodyFilter.frequency.setValueAtTime(inst === 'FLUTE' ? 2400 : 3100, when);
            }

            if (slideFromMidi) {
                const startFreq = midiToFreq(slideFromMidi);
                osc.frequency.setValueAtTime(startFreq, when);
                osc.frequency.exponentialRampToValueAtTime(freq, when + Math.min(0.11, duration * 0.38));
                osc2.frequency.setValueAtTime(startFreq * 1.002, when);
                osc2.frequency.exponentialRampToValueAtTime(freq * 1.002, when + Math.min(0.11, duration * 0.38));
            } else {
                osc.frequency.setValueAtTime(freq, when);
                osc2.frequency.setValueAtTime(freq * 1.0025, when);
            }

            const attack = inst === 'ERHU' ? 0.035 : (inst === 'VIOLIN' ? 0.055 : 0.04);
            env.gain.setValueAtTime(0.0001, when);
            env.gain.linearRampToValueAtTime(vol, when + attack);
            env.gain.setValueAtTime(vol * 0.86, when + duration * 0.72);
            env.gain.exponentialRampToValueAtTime(0.0001, when + duration + 0.06);

            osc.connect(bodyFilter);
            osc2.connect(bodyFilter);
            bodyFilter.connect(env);
            env.connect(masterGain);
            if (masterConvolver) env.connect(masterConvolver);

            lfo.start(when);
            osc.start(when);
            osc2.start(when);
            lfo.stop(when + duration + 0.08);
            osc.stop(when + duration + 0.08);
            osc2.stop(when + duration + 0.08);
        }

        // Warm Bowed String Pad + Cello Bass + Pizzicato Accompaniment (Gives Video 2 its true Chamber Orchestra fullness)
        function scheduleChamberHarmony(when, bassMidi, chordMidis, duration, isPizzicato = false, vol = 0.032) {
            if (!audioCtx) return;

            // 1. Deep Bowed Cello & Contrabass Foundation
            const bassOsc = audioCtx.createOscillator();
            const bassFilter = audioCtx.createBiquadFilter();
            const bassGain = audioCtx.createGain();
            bassOsc.setPeriodicWave(customPeriodicWaves.VIOLIN);
            bassOsc.frequency.setValueAtTime(midiToFreq(bassMidi), when);
            bassFilter.type = 'lowpass';
            bassFilter.frequency.setValueAtTime(480, when);
            bassGain.gain.setValueAtTime(0.0001, when);
            bassGain.gain.linearRampToValueAtTime(vol * 1.65, when + 0.04);
            bassGain.gain.exponentialRampToValueAtTime(0.0001, when + duration);
            bassOsc.connect(bassFilter);
            bassFilter.connect(bassGain);
            bassGain.connect(masterGain);
            if (masterConvolver) bassGain.connect(masterConvolver);
            bassOsc.start(when);
            bassOsc.stop(when + duration + 0.05);

            // 2. Chamber String Ensemble Chords (Sustained Arco + Plucked Pizzicato)
            chordMidis.forEach((m, i) => {
                const osc = audioCtx.createOscillator();
                const filter = audioCtx.createBiquadFilter();
                const gain = audioCtx.createGain();
                osc.setPeriodicWave(customPeriodicWaves.VIOLIN);
                osc.frequency.setValueAtTime(midiToFreq(m), when);
                osc.detune.setValueAtTime(i % 2 === 0 ? -5 : 5, when);

                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(isPizzicato ? 1600 : 1950, when);

                const noteDur = isPizzicato ? Math.min(0.22, duration) : duration;
                gain.gain.setValueAtTime(0.0001, when);
                gain.gain.linearRampToValueAtTime(vol, when + (isPizzicato ? 0.012 : 0.09));
                gain.gain.exponentialRampToValueAtTime(0.0001, when + noteDur);

                osc.connect(filter);
                filter.connect(gain);
                gain.connect(masterGain);
                if (masterConvolver) gain.connect(masterConvolver);
                osc.start(when);
                osc.stop(when + noteDur + 0.04);
            });
        }

        // Sample-Accurate Traditional & Orchestral Percussion
        function schedulePercussionAt(when, type = 'WOODBLOCK', vol = 0.09) {
            if (!audioCtx) return;

            if (type === 'WOODBLOCK') {
                // Crisp bamboo/wooden clapper (Phách tre / Song loan in Video 1 0:00-0:09)
                const osc = audioCtx.createOscillator();
                const filter = audioCtx.createBiquadFilter();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(1620, when);
                osc.frequency.exponentialRampToValueAtTime(790, when + 0.038);
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(1380, when);
                filter.Q.setValueAtTime(3.5, when);
                gain.gain.setValueAtTime(vol, when);
                gain.gain.exponentialRampToValueAtTime(0.0001, when + 0.048);
                osc.connect(filter);
                filter.connect(gain);
                gain.connect(masterGain);
                osc.start(when);
                osc.stop(when + 0.055);
            } else if (type === 'ANVIL') {
                [2380, 3760].forEach(f => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(f, when);
                    gain.gain.setValueAtTime(vol * 0.45, when);
                    gain.gain.exponentialRampToValueAtTime(0.0001, when + 0.18);
                    osc.connect(gain);
                    gain.connect(masterGain);
                    osc.start(when);
                    osc.stop(when + 0.2);
                });
            } else if (type === 'TAIKO') {
                // Deep Cinematic Festival Drum (Trống Sấm in Video 1 & Timpani in Video 2)
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(145, when);
                osc.frequency.exponentialRampToValueAtTime(44, when + 0.35);
                gain.gain.setValueAtTime(vol * 1.55, when);
                gain.gain.exponentialRampToValueAtTime(0.0001, when + 0.42);
                osc.connect(gain);
                gain.connect(masterGain);
                if (masterConvolver) gain.connect(masterConvolver);
                osc.start(when);
                osc.stop(when + 0.45);
            } else if (type === 'SNARE_BRUSH') {
                // Chamber Snare / Brush groove for Video 2
                const len = Math.floor(audioCtx.sampleRate * 0.12);
                const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
                const d = buf.getChannelData(0);
                for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.2);
                const src = audioCtx.createBufferSource();
                src.buffer = buf;
                const flt = audioCtx.createBiquadFilter();
                flt.type = 'bandpass';
                flt.frequency.setValueAtTime(2200, when);
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(vol * 0.45, when);
                src.connect(flt);
                flt.connect(gain);
                gain.connect(masterGain);
                src.start(when);
            } else if (type === 'CYMBAL_SWELL') {
                const len = Math.floor(audioCtx.sampleRate * 1.4);
                const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
                const d = buf.getChannelData(0);
                for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
                const src = audioCtx.createBufferSource();
                src.buffer = buf;
                const flt = audioCtx.createBiquadFilter();
                flt.type = 'highpass';
                flt.frequency.setValueAtTime(3400, when);
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0.0001, when);
                gain.gain.linearRampToValueAtTime(vol * 0.75, when + 0.06);
                gain.gain.exponentialRampToValueAtTime(0.0001, when + 1.35);
                src.connect(flt);
                flt.connect(gain);
                gain.connect(masterGain);
                if (masterConvolver) gain.connect(masterConvolver);
                src.start(when);
            }
        }

