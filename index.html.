                            <p>• <b>10 Thẻ Biến Động (!):</b> Hiệu ứng thị trường tức thì (<i>Bão giá x2, Được mùa x2, OCOP 5 Sao +120đ, UNESCO vinh danh tặng Công cụ, Chuyến tàu di sản, Triều cường...</i>).<br>
                            • <b>7 Thẻ Bản Lĩnh (?):</b> Giữ trên tay để bấm kích hoạt lúc có lợi (<i>Thánh mặc cả -30%, Vé VIP, Tốc hành đổ xúc xắc 2 lần, Bí truyền nghệ nhân tặng 2 Công cụ, Liên kết Hợp tác xã, Đại sứ du lịch, Bước nhảy thương gia</i>).</p>
                        </div>
                    </div>
                    <button onclick="closeModal()" class="wood-btn mt-4 py-2.5 rounded-xl font-extrabold text-sm w-full">Đã Sẵn Sàng Khởi Hành!</button>
                </div>
            `);
        }

        function openModal(htmlContent) {
            const overlay = document.getElementById('modal-overlay');
            const box = document.getElementById('modal-box');
            box.innerHTML = htmlContent;
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            requestAnimationFrame(() => {
                box.classList.remove('scale-95', 'opacity-0');
                box.classList.add('scale-100', 'opacity-100');
            });
        }

        function closeModal() {
            const overlay = document.getElementById('modal-overlay');
            const box = document.getElementById('modal-box');
            box.classList.remove('scale-100', 'opacity-100');
            box.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                overlay.classList.remove('flex');
                overlay.classList.add('hidden');
            }, 180);
        }

        /*************************************************************************
         * 12. INITIALIZE ON WINDOW LOAD
         *************************************************************************/
        window.onload = function () {
            init3DScene();
            updateAllHUD();
            updateTileInspector(0);
            start45MinTimer();

            addLog('Chào mừng 5 Thương Khách: <b>Quốc Anh, Khánh Vy, Quốc An, Ngọc Vy & Kim</b> đến với <b>Sa Bàn 3D Du Ký Làng Nghề Việt Nam</b>!', '🏯', 'text-amber-300 font-semibold');
            addLog('Bấm nút <b>"Hướng Dẫn Chơi"</b> hoặc <b>"Chế Độ 5 Người"</b> ở góc trên để xem luật chơi và tùy chỉnh chế độ Nhiều Người Chơi!', '💡');
            showBanner('Sa bàn 3D 5 Thương Khách đã sẵn sàng!', '🏯', 3500);
        };
    </script>
