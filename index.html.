                        new THREE.ConeGeometry((0.18 - idx * 0.04) * scale, 0.24 * scale, 10),
                        new THREE.MeshStandardMaterial({ color: 0x065f46, roughness: 0.75 })
                    );
                    cone.position.y = py * scale;
