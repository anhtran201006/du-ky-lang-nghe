            spawnOwnerBannerOnTile(tile.index, player.id);
            updateAllHUD();
            updateTileInspector(tile.index);

            addLog(`🏳️ <b>${player.shortName}</b> đầu tư <b>${pricePaid} đồng</b> sở hữu <b>${tile.name} (${tile.region})</b> và cắm cờ thương hiệu!`, tile.icon, 'text-emerald-300 font-semibold');
            showBanner(`${player.shortName} sở hữu ${tile.name}!`, tile.icon, 2000);
        }

