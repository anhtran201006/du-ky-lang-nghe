            requestAnimationFrame(animate3D);
            if (controls) controls.update();

            const time = performance.now() * 0.002;
            animatedElements.forEach(item => {
                if (item.type === 'WHEEL') {
                    item.mesh.rotation.z += 0.06;
                } else if (item.type === 'STIRRER') {
                    item.mesh.rotation.y += 0.08;
                } else if (item.type === 'ARTISAN') {
                    item.mesh.position.y = item.baseY + Math.sin(time * 2.2 + item.phase) * 0.015;
                    item.mesh.rotation.z = Math.sin(time * 1.8 + item.phase) * 0.05;
                } else if (item.type === 'FLAG') {
                    item.mesh.rotation.y = Math.sin(time * 2.5 + item.phase) * 0.18;
                } else if (item.type === 'CHEVRON') {
                    item.mesh.scale.setScalar(0.85 + Math.sin(time * 3 + item.phase) * 0.2);
                }
            });

            playerPawns.forEach((pw, i) => {
                const f = pw.userData.figure;
                if (f) { f.scale.y = 1 + Math.sin(time * 1.6 + i) * 0.008; f.rotation.y = pw.userData.faceY + Math.sin(time * 0.9 + i * 1.3) * 0.06; }
            });
            renderer.render(scene, camera);
        }

        /*************************************************************************
         * 6. HUD RENDERING, INSPECTOR & LOGGING (HỖ TRỢ TỐI ĐA 5 NGƯỜI CHƠI & CHẾ ĐỘ MULTIPLAYER)
