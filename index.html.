                    visitor.tools.splice(matchingToolIdx, 1);
                    playSFX('card');
                    addLog(`🛠️ <b>${visitor.shortName}</b> bước vào <b>${tile.name}</b> và tung thẻ <b>"${toolInfo.shortName}"</b> tự giải quyết tình huống làm nghề -> <b>Miễn phí dịch vụ!</b>`, '✨', 'text-teal-300 font-semibold');
