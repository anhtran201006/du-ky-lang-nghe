        // --- CASE 3: TOOL SHOP (Ô TRẠM DỪNG) ---
        async function handleToolShopVisit(player, tile) {
            const priceMultiplier = gameState.toolPriceInflationTurns > 0 ? 2 : 1;

            if (player.isNPC) {
                await sleep(900);
                // NPC buys up to 1 tool card if cash > 140 and holds < 2 tools
                const toolKeys = Object.keys(TOOL_CATEGORIES);
                const missingKeys = toolKeys.filter(k => !player.tools.includes(k));
                const pickKey = missingKeys.length > 0 ? missingKeys[Math.floor(Math.random() * missingKeys.length)] : toolKeys[0];
                const tool = TOOL_CATEGORIES[pickKey];
                const cost = tool.basePrice * priceMultiplier;

                if (player.tools.length < 2 && player.cash - cost >= 90) {
                    player.cash -= cost;
                    player.tools.push(pickKey);
                    playSFX('card');
                    addLog(`🛠️ Tại <b>${tile.name}</b>, <b>${player.shortName}</b> mua dự trữ thẻ <b>"${tool.shortName}"</b> (${cost}đ).`, '🎒');
                    showBanner(`${player.shortName} mua ${tool.shortName}`, '🛠️', 1600);
                    updateAllHUD();
                } else {
                    addLog(`<b>${player.shortName}</b> ghé <b>${tile.name}</b> nghỉ ngơi nhưng không mua thêm công cụ.`, '⛺');
                }
                await sleep(800);
                return;
            }

            // User Interactive Tool Shop Modal
            return new Promise(resolve => {
                const renderShopModal = () => {
                    const itemsHTML = Object.values(TOOL_CATEGORIES).map(tool => {
                        const cost = tool.basePrice * priceMultiplier;
                        const ownedCount = player.tools.filter(id => id === tool.id).length;
                        const canBuy = player.cash >= cost;
                        return `
                            <div class="bg-amber-950/10 border border-amber-800/30 p-3 rounded-2xl flex items-center justify-between gap-2 text-left">
                                <div class="flex items-center gap-2.5">
                                    <span class="text-2xl">${tool.icon}</span>
                                    <div>
                                        <div class="font-bold text-xs text-amber-950">${tool.name} <span class="text-[10px] bg-teal-800 text-white px-1.5 py-0.5 rounded-full ml-1">Đang có: ${ownedCount}</span></div>
                                        <div class="text-[10px] text-amber-900/80 leading-tight mt-0.5">${tool.desc}</div>
                                    </div>
                                </div>
                                <button onclick="buyToolFromShop('${tool.id}', ${cost})" ${canBuy ? '' : 'disabled'}
                                    class="wood-btn px-3 py-2 rounded-xl font-extrabold text-xs shrink-0">
                                    Mua ${cost}đ
                                </button>
                            </div>
                        `;
                    }).join('');

                    openModal(`
                        <div class="text-center">
                            <span class="px-3 py-1 rounded-full bg-teal-800 text-teal-100 text-xs font-extrabold uppercase">Ô Trạm Dừng • Tiếp Tế Vật Tư</span>
                            <h2 class="font-serif-vn font-extrabold text-2xl text-amber-950 mt-2">${tile.name}</h2>
                            <p class="text-xs text-amber-900/80 mt-0.5">Số dư hiện tại của bạn: <b class="text-emerald-800 text-sm">${player.cash} đồng</b> ${priceMultiplier > 1 ? '<span class="text-red-700 font-bold">(Đang Bão Giá x2)</span>' : ''}</p>
                            
                            <div class="space-y-2 my-4 max-h-64 overflow-y-auto pr-1">
                                ${itemsHTML}
                            </div>

                            <button id="modal-close-shop" class="bg-stone-700 hover:bg-stone-600 text-amber-100 font-extrabold px-6 py-2.5 rounded-xl text-sm w-full">
                                Hoàn Tất Mua Sắm & Kết Thúc Lượt
                            </button>
                        </div>
                    `);

                    document.getElementById('modal-close-shop').onclick = () => {
                        closeModal();
                        resolve();
                    };
                };

                window.buyToolFromShop = (toolId, cost) => {
                    if (player.cash < cost) return;
                    player.cash -= cost;
                    player.tools.push(toolId);
                    playSFX('card');
                    addLog(`🛠️ <b>Bạn</b> đã mua dự trữ <b>${TOOL_CATEGORIES[toolId].shortName}</b> với giá <b>${cost} đồng</b>.`, '🎒', 'text-teal-300');
                    updateAllHUD();
                    renderShopModal();
                };

                renderShopModal();
            });
        }

        // --- CASE 4A: THẺ BIẾN ĐỘNG (!) ---
        async function handleBienDongDraw(player) {
            playSFX('card');
            const card = BIEN_DONG_CARDS[Math.floor(Math.random() * BIEN_DONG_CARDS.length)];

            const applyBienDongEffect = async () => {
                if (card.id === 'BAO_GIA') {
                    const activeCount = PLAYERS.filter(p => p.active && !p.bankrupt).length;
                    gameState.toolPriceInflationTurns = activeCount;
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} bốc thẻ: Giá mọi Thẻ Công Cụ tăng gấp đôi trong 1 vòng!`, '📈', 'text-red-300 font-semibold');
                } else if (card.id === 'DUOC_MUA') {
                    const activeCount = PLAYERS.filter(p => p.active && !p.bankrupt).length;
                    player.doubleRentTurns = activeCount;
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} được mùa lớn: Nhân đôi lợi nhuận thu phí dịch vụ trong 1 vòng!`, '🌾', 'text-emerald-300 font-semibold');
                } else if (card.id === 'MAT_MUA') {
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} phải nộp 50 đồng cho Ngân hàng để tu sửa làng nghề.`, '⛈️', 'text-red-300');
