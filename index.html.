         *************************************************************************/
        const WIN_WEALTH = 2500;
        function netWorth(p) { return p.cash + p.properties.reduce((t, i) => t + BOARD_TILES[i].price, 0); }
        function tradeSetsOwned(p) {
            const by = {};
            BOARD_TILES.forEach(t => { if (t.type === 'PROPERTY') (by[t.toolId] = by[t.toolId] || []).push(t.index); });
            return Object.values(by).filter(a => a.every(i => p.properties.includes(i))).length;
        }
        function checkVictory() {
            if (gameState.gameEnded) return false;
            for (const p of PLAYERS) {
                if (!p.active || p.bankrupt) continue;
                if (netWorth(p) >= WIN_WEALTH) { finishGameAndAudit(`💰 ${p.shortName} đạt ${WIN_WEALTH} đồng tổng tài sản - Đại Phú Gia!`, p.id); return true; }
                if (tradeSetsOwned(p) >= 2) { finishGameAndAudit(`🏺 ${p.shortName} độc quyền 2 ngành nghề - Bá Chủ Làng Nghề!`, p.id); return true; }
            }
            return false;
        }
        async function declareBankruptcy(payer, creditor, why) {
            payer.bankrupt = true;
            const props = [...payer.properties];
            payer.properties = []; payer.tools = []; payer.skills = [];
            if (creditor) creditor.cash += payer.cash;
            payer.cash = 0;
            props.forEach(i => {
                removeOwnerBannerFromTile(i);
                if (creditor) { creditor.properties.push(i); gameState.propertyOwners[i] = creditor.id; spawnOwnerBannerOnTile(i, creditor.id); }
                else delete gameState.propertyOwners[i];
            });
            playSFX('penalty');
            const pw = playerPawns[payer.id];
            gsap.to(pw.rotation, { y: '+=12', duration: 1.2 });
            gsap.to(pw.scale, { x: 0.01, y: 0.01, z: 0.01, duration: 1.2, ease: 'back.in(2)', onComplete: () => { pw.visible = false; } });
            addLog(`💥 <b>${payer.shortName}</b> PHÁ SẢN (${why})! ${creditor ? `Toàn bộ tiền và <b>${props.length} ô di sản</b> chuyển cho <b>${creditor.shortName}</b>.` : `<b>${props.length} ô di sản</b> được trả về thị trường.`}`, '💥', 'text-red-400 font-extrabold');
            showBanner(`${payer.shortName} đã phá sản!`, '💥', 2500);
            updateAllHUD();
            await sleep(1400);
            const survivors = PLAYERS.filter(p => p.active && !p.bankrupt);
            if (survivors.length <= 1) { finishGameAndAudit('Chỉ còn 1 người chơi trụ lại trên bàn cờ!', survivors[0] && survivors[0].id); return; }
            if (!payer.isNPC && PLAYERS.some(p => p.active && !p.isNPC && !p.bankrupt)) return;
            if (!payer.isNPC) {
                openModal(`<div class="text-center"><div class="text-5xl">💀</div>
                    <h2 class="font-serif-vn font-extrabold text-2xl text-red-900 mt-2">${payer.shortName} đã phá sản!</h2>
                    <p class="text-xs text-amber-950 mt-1">Bạn không còn đủ tiền và di sản để thanh toán. Ván đấu vẫn tiếp tục giữa các thương khách còn lại.</p>
                    <button onclick="closeModal()" class="wood-btn mt-4 py-3 rounded-xl font-extrabold text-sm w-full">👁️ Xem Tiếp Ván Đấu</button></div>`);
            }
        }
        function surrenderCurrent() {
            const p = PLAYERS[gameState.currentPlayerIdx];
            if (!p || p.isNPC || p.bankrupt || gameState.gameEnded || gameState.isBusy) return;
            if (!confirm(`${p.shortName} xác nhận ĐẦU HÀNG và tuyên bố phá sản? Toàn bộ di sản sẽ trả về thị trường.`)) return;
            gameState.isBusy = true;
            declareBankruptcy(p, null, 'đầu hàng').then(() => { if (!gameState.gameEnded) advanceToNextTurn(); });
        }
        async function processPaymentOrBankruptcy(payer, receiver, amount, reasonText) {
            if (payer.cash + payer.properties.reduce((t, i) => t + BOARD_TILES[i].price, 0) < amount) {
                addLog(`⚠️ <b>${payer.shortName}</b> không đủ khả năng chi trả <b>${amount} đồng</b> (${reasonText}).`, '⚠️', 'text-red-300');
                await declareBankruptcy(payer, receiver, reasonText);
                return;
            }
            // While payer lacks cash but still owns properties, mortgage properties back to the Bank
            while (payer.cash < amount && payer.properties.length > 0) {
                if (payer.isNPC) {
                    const soldTileIdx = payer.properties.shift();
                    const soldTile = BOARD_TILES[soldTileIdx];
                    payer.cash += soldTile.price;
                    delete gameState.propertyOwners[soldTileIdx];
                    removeOwnerBannerFromTile(soldTileIdx);
                    addLog(`🏦 Do thiếu tiền mặt, <b>${payer.shortName}</b> phải bán thế chấp <b>${soldTile.name}</b> lại cho Ngân hàng thu về <b>${soldTile.price} đồng</b>.`, '⚠️', 'text-amber-300');
                    updateAllHUD();
                    await sleep(800);
                } else {
                    await promptUserMortgageModal(payer, amount - payer.cash);
                }
            }

            if (payer.cash >= amount) {
                payer.cash -= amount;
                if (receiver) {
                    receiver.cash += amount;
                    playSFX('coin');
                    addLog(`💸 <b>${payer.shortName}</b> trả <b>${amount} đồng</b> ${reasonText} cho <b>${receiver.shortName}</b>.`, '💸');
                    showBanner(`${payer.shortName} trả ${amount}đ cho ${receiver.shortName}`, '💸', 1800);
                } else {
                    playSFX('penalty');
                    addLog(`🏦 <b>${payer.shortName}</b> nộp <b>${amount} đồng</b> (${reasonText}) vào Ngân hàng.`, '🏦');
                }
                updateAllHUD();
                await sleep(700);
            } else {
                payer.bankrupt = true;
                if (receiver) receiver.cash += payer.cash;
                payer.cash = 0;
                playerPawns[payer.id].visible = false;
                playSFX('penalty');
                addLog(`💥 <b>${payer.shortName}</b> đã cạn kiệt cả Tiền Mặt lẫn Tài Sản và chính thức <b>PHÁ SẢN</b>!`, '💥', 'text-red-400 font-extrabold');
                showBanner(`${payer.shortName} đã phá sản!`, '💥', 2500);
                updateAllHUD();
                await sleep(1000);

                const survivors = PLAYERS.filter(p => p.active && !p.bankrupt);
                if (survivors.length <= 1) {
                    finishGameAndAudit('Chỉ còn 1 người chơi trụ lại trên bàn cờ!');
                }
            }
        }

