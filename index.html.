            // Turn Indicator & Dice Button State (Enabled whenever current player is a Human!)
            document.getElementById('turn-indicator-text').textContent = !currP.isNPC ? `Lượt của ${currP.shortName}!` : `Lượt của ${currP.shortName} (NPC)...`;
