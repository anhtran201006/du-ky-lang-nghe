        function stopAllMusicSources() {
            if (schedulerTimer) {
                clearInterval(schedulerTimer);
                schedulerTimer = null;
            }
            if (activeMediaElement) {
                activeMediaElement.pause();
            }
        }

        function startSelectedMusicSource() {
            stopAllMusicSources();
            if (!bgmEnabled) return;

            // Priority 1: If original video/audio file for this track is available, play the exact 100% original stream!
            const mediaTrack = uploadedTracks[musicStyle];
            if (mediaTrack) {
                activeMediaElement = mediaTrack;
                mediaTrack.play().catch(() => {});
                return;
            }

            // Priority 2: High-Precision Web Audio Lookahead Sequencer (0 jitter)
            initAudioContext();
            currentStepIdx = 0;
            nextStepTime = audioCtx.currentTime + 0.05;

            schedulerTimer = setInterval(() => {
                if (!bgmEnabled || !audioCtx) return;
                const steps = musicStyle === 'THINH_VUONG_CHAMBER' ? THINH_VUONG_STEPS : NGHE_XUA_STEPS;

                while (nextStepTime < audioCtx.currentTime + 0.18) {
                    const step = steps[currentStepIdx % steps.length];
                    if (!document.hidden) {
                        if (step.bass && step.chord) {
                            scheduleChamberHarmony(nextStepTime, step.bass, step.chord, step.dur * 1.9, false, 0.028);
                        } else if (step.pizz) {
                            scheduleChamberHarmony(nextStepTime, step.pizz[0] - 12, step.pizz, step.dur, true, 0.026);
                        }
                        if (step.inst && step.note) {
                            scheduleAcousticInstrument(nextStepTime, step.note, step.dur * 0.95, step.inst, 0.075, step.prev || null);
                        }
                        if (step.perc) {
                            step.perc.forEach(pType => schedulePercussionAt(nextStepTime, pType, 0.085));
                        }
                    }
                    nextStepTime += step.dur;
                    currentStepIdx++;
                }
            }, 35);
        }

        function toggleAudio() {
            initAudioContext();
            bgmEnabled = !bgmEnabled;
            const icon = document.getElementById('audio-icon');
            if (bgmEnabled) {
                icon.className = 'fa-solid fa-volume-high text-emerald-400';
                startSelectedMusicSource();
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-amber-300/70';
                stopAllMusicSources();
            }
        }

        function switchMusicStyle() {
            initAudioContext();
            musicStyle = musicStyle === 'THINH_VUONG_CHAMBER' ? 'NGHE_XUA_HON_NAY' : 'THINH_VUONG_CHAMBER';

            const label = document.getElementById('audio-label');
            if (label) {
                label.textContent = musicStyle === 'THINH_VUONG_CHAMBER'
                    ? 'Thịnh Vượng VN (Thính Phòng)'
                    : 'Nghề Xưa Hồn Nay (Đàn Nhị)';
            }

            if (!bgmEnabled) {
                bgmEnabled = true;
                document.getElementById('audio-icon').className = 'fa-solid fa-volume-high text-emerald-400';
            }
            startSelectedMusicSource();

            showBanner(
                musicStyle === 'THINH_VUONG_CHAMBER'
                    ? '🎻 Đang phát Bài 1: Thịnh Vượng Việt Nam Sáng Ngời (Bản Thính Phòng)'
                    : '🪕 Đang phát Bài 2: Nghề Xưa Hồn Nay (Phách Tre, Trống Sấm & Đàn Nhị)',
                '🎵', 2400
            );
        }

        function playSFX(type) {
            try {
                initAudioContext();
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                if (type === 'dice') {
                    for (let i = 0; i < 4; i++) {
                        schedulePercussionAt(now + i * 0.065, 'WOODBLOCK', 0.09);
                    }
                } else if (type === 'step') {
                    schedulePercussionAt(now, 'WOODBLOCK', 0.06);
                } else if (type === 'coin') {
                    scheduleAcousticInstrument(now, 74, 0.22, 'FLUTE', 0.07);
                    scheduleAcousticInstrument(now + 0.09, 81, 0.35, 'FLUTE', 0.07);
                } else if (type === 'build') {
                    schedulePercussionAt(now, 'TAIKO', 0.09);
                    [62, 66, 69, 74].forEach((m, idx) => {
                        scheduleAcousticInstrument(now + idx * 0.075, m, 0.45, 'VIOLIN', 0.07);
                    });
                } else if (type === 'card') {
                    scheduleAcousticInstrument(now, 69, 0.16, 'FLUTE', 0.06);
                    scheduleAcousticInstrument(now + 0.06, 74, 0.22, 'FLUTE', 0.06);
                } else if (type === 'penalty') {
                    schedulePercussionAt(now, 'TAIKO', 0.1);
                    scheduleAcousticInstrument(now, 58, 0.45, 'OBOE', 0.07);
                }
            } catch (e) {}
        }

