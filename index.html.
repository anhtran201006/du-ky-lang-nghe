        function getCurrentHumanControlPlayer() {
            const curr = PLAYERS[gameState.currentPlayerIdx];
            if (curr && curr.active && !curr.isNPC && !curr.bankrupt) return curr;
            return PLAYERS.find(p => p.active && !p.isNPC) || PLAYERS[0];
        }

