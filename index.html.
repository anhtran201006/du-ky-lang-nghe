        // Render bespoke 2D heritage badge art onto tile base & inspector canvas
        function renderTileArtToCanvas(tile, canvas) {
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            // Kraft paper background
            const grad = ctx.createRadialGradient(w / 2, h / 2, 10, w / 2, h / 2, w / 2);
            grad.addColorStop(0, '#fdf6e2');
            grad.addColorStop(1, '#e6d2aa');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, w, h);

            // Ornamental border ring
            ctx.strokeStyle = tile.color || '#8c5a32';
            ctx.lineWidth = Math.max(4, w * 0.04);
            ctx.beginPath();
            ctx.arc(w / 2, h / 2, w * 0.44, 0, Math.PI * 2);
            ctx.stroke();

            // Inner subtle ring
            ctx.strokeStyle = 'rgba(139, 90, 43, 0.35)';
            ctx.lineWidth = Math.max(2, w * 0.015);
            ctx.beginPath();
            ctx.arc(w / 2, h / 2, w * 0.37, 0, Math.PI * 2);
            ctx.stroke();

            // Center icon
            ctx.font = `${Math.floor(w * 0.38)}px sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(tile.icon || '🏯', w / 2, h * 0.46);

            // Bottom price or index badge
            ctx.fillStyle = tile.color || '#5c3a21';
            ctx.font = `800 ${Math.floor(w * 0.11)}px "Be Vietnam Pro", sans-serif`;
            const footerText = tile.type === 'PROPERTY' ? `${tile.price}Đ` : `#${tile.index}`;
            ctx.fillText(footerText, w / 2, h * 0.8);
        }

        /***************************************************************************************
         * 5. DỰNG 24 Ô ĐỊA DANH + TỔ HỢP MÔ HÌNH KIẾN TRÚC 3D (DIORAMA) TRỰC TIẾP TRÊN MỖI Ô
         ***************************************************************************************/
        function build24GeographicalTilesWithDioramas() {
            BOARD_TILES.forEach((tile, idx) => {
                const tileGroup = new THREE.Group();
                tileGroup.position.set(tile.mapX, tile.elevation, tile.mapZ);

                // 1. Octagonal / Circular Carved Wooden & Kraft Platform Base
                const baseRadius = tile.type === 'START' || tile.type === 'SHOP' ? 1.28 : 1.15;
                const baseGeo = new THREE.CylinderGeometry(baseRadius, baseRadius * 1.08, 0.28, 28);

                const canvas = document.createElement('canvas');
                canvas.width = 256;
                canvas.height = 256;
                renderTileArtToCanvas(tile, canvas);
                const topTex = new THREE.CanvasTexture(canvas);

                const sideMat = new THREE.MeshStandardMaterial({ color: 0x5c3a21, roughness: 0.65 });
                const topMat = new THREE.MeshStandardMaterial({ map: topTex, roughness: 0.55 });

                const platformMesh = new THREE.Mesh(baseGeo, [sideMat, topMat, sideMat]);
                platformMesh.receiveShadow = true;
                platformMesh.castShadow = true;
                platformMesh.userData = { tileIndex: idx };
                tileGroup.add(platformMesh);
                tileMeshes.push(platformMesh);

                // 2. Owner Status Rim Ring (Glows in Owner's Color when Purchased)
                const ringGeo = new THREE.TorusGeometry(baseRadius * 1.03, 0.08, 12, 32);
                const ringMat = new THREE.MeshStandardMaterial({
                    color: new THREE.Color(tile.color),
                    roughness: 0.3,
                    metalness: 0.25
                });
                const ringMesh = new THREE.Mesh(ringGeo, ringMat);
                ringMesh.rotation.x = Math.PI / 2;
                ringMesh.position.y = 0.12;
                tileGroup.add(ringMesh);
                tileBaseRings.push(ringMesh);

                // 3. PERMANENT 3D ARCHITECTURAL DIORAMA ON EVERY TILE RIGHT FROM THE START!
                const diorama = createBespokeTileDiorama(tile);
                diorama.position.set(0, 0.15, 0);
                diorama.traverse(child => {
                    if (child.isMesh) {
                        child.castShadow = true;
                        child.receiveShadow = true;
                        child.userData = { tileIndex: idx };
                        tileMeshes.push(child);
                    }
                });
                tileGroup.add(diorama);

                // 4. Sleek, Non-Obstructive 3D Number Badge at the front rim of the tile (Never blocks the 3D building!)
                const shortName = tile.name.replace(/Làng |Vườn |Cánh Đồng |Đồi /g, '');
                const compactSprite = createCompactTileBadgeSprite(idx, shortName, tile.color, tile.price);
                compactSprite.position.set(0, 1.55, 0.65);
                compactSprite.scale.set(1.75, 0.52, 1);
                tileGroup.add(compactSprite);
                tileLabelSprites.push({ sprite: compactSprite, tile });

                scene.add(tileGroup);
            });
        }

        function createCompactTileBadgeSprite(idx, shortName, bgHex, price) {
            const c = document.createElement('canvas');
            c.width = 384;
            c.height = 112;
            const ctx = c.getContext('2d');

            // Dark translucent pill with gold border
            ctx.fillStyle = 'rgba(28, 18, 10, 0.88)';
            ctx.strokeStyle = '#fbbf24';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.roundRect(6, 8, 372, 96, 48);
            ctx.fill();
            ctx.stroke();

            // Left circular number badge
            ctx.fillStyle = bgHex;
            ctx.beginPath();
            ctx.arc(54, 56, 38, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.font = '900 32px "Be Vietnam Pro", sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(`${idx}`, 54, 58);

            // Location Short Name & Price
            ctx.textAlign = 'left';
            ctx.fillStyle = '#fef3c7';
            ctx.font = '800 26px "Be Vietnam Pro", sans-serif';
            ctx.fillText(shortName.slice(0, 16), 104, price ? 44 : 58);

            if (price) {
                ctx.fillStyle = '#34d399';
                ctx.font = '700 22px "Be Vietnam Pro", sans-serif';
                ctx.fillText(`${price} đồng`, 104, 76);
            }

            const tex = new THREE.CanvasTexture(c);
            const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
            return new THREE.Sprite(mat);
        }

        // Build Continuous, Closed-Loop 32-Tile Heritage Trail (Vòng Tròn Khép Kín 100% Từ #0 -> #19 Cà Mau -> #20 Đảo Phú Quốc -> #21..#31 -> #0 Hà Nội)
        function buildHeritageTrailConnections() {
            const cobbleMat = new THREE.MeshStandardMaterial({
                color: 0xfde047,
                emissive: 0xf59e0b,
                emissiveIntensity: 0.42,
                roughness: 0.32
            });
            const trimMat = new THREE.MeshStandardMaterial({
                color: 0xb91c1c,
                roughness: 0.5
