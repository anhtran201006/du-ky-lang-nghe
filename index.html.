            const allCards = [
                ...handOwner.tools.map((tId) => {
                    const tool = TOOL_CATEGORIES[tId];
                    return `
                        <div class="shrink-0 bg-teal-900/10 border border-teal-700/40 px-2.5 py-1 rounded-xl flex items-center gap-1.5 text-xs" title="${tool.desc}">
                            <span>${tool.icon}</span>
