                } else if (card.id === 'THUONG_LAI_EP_GIA') {
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} phải nộp 40 đồng phí lưu kho bảo quản nông sản.`, '📉', 'text-red-300');
                    await processPaymentOrBankruptcy(player, null, 40, 'phí lưu kho bảo quản');
                } else if (card.id === 'TRIEU_CUONG') {
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} nộp 45 đồng gia cố đê bao chống xâm nhập mặn.`, '🌊', 'text-red-300');
                    await processPaymentOrBankruptcy(player, null, 45, 'chi phí gia cố đê bao');
                } else if (card.id === 'LE_HOI') {
                    player.cash += 100;
                    playSFX('coin');
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} nhận ngay <b>+100 đồng</b> tiền thưởng lễ hội từ Ngân hàng!`, '🏮', 'text-emerald-300 font-semibold');
                } else if (card.id === 'OCOP_5_SAO') {
                    player.cash += 120;
                    playSFX('coin');
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} đạt chuẩn OCOP 5 sao, nhận thưởng nóng <b>+120 đồng</b>!`, '🌟', 'text-emerald-300 font-semibold');
                } else if (card.id === 'UNESCO_VINH_DANH') {
                    const toolKeys = Object.keys(TOOL_CATEGORIES);
                    const freeTool = toolKeys[Math.floor(Math.random() * toolKeys.length)];
                    player.tools.push(freeTool);
                    player.cash += 50;
                    playSFX('coin');
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} được tặng <b>+50 đồng</b> và 1 thẻ <b>${TOOL_CATEGORIES[freeTool].shortName}</b>!`, '🏛️', 'text-emerald-300 font-semibold');
                } else if (card.id === 'CHUYEN_TAU_DI_SAN') {
                    PLAYERS.forEach(p => {
                        if (p.active && !p.bankrupt) {
                            p.cash += (p.id === player.id ? 80 : 40);
                        }
                    });
                    playSFX('coin');
                    addLog(`❗ <b>[${card.title}]</b> Chuyến tàu di sản mang khách đến! <b>${player.shortName}</b> nhận <b>+80 đồng</b>, các thương khách khác nhận <b>+40 đồng</b>!`, '🚂', 'text-emerald-300 font-semibold');
                } else if (card.id === 'XUAT_KHAU') {
                    const bonus = Math.max(60, player.properties.length * 35);
                    player.cash += bonus;
                    playSFX('coin');
                    addLog(`❗ <b>[${card.title}]</b> ${player.shortName} nhận <b>+${bonus} đồng</b> từ đơn hàng xuất khẩu làng nghề!`, '🚢', 'text-emerald-300 font-semibold');
                }
                updateAllHUD();
            };

            if (player.isNPC) {
                showBanner(`${player.shortName} bốc Thẻ Biến Động: ${card.title}`, card.icon, 2000);
                await sleep(1100);
                await applyBienDongEffect();
                await sleep(700);
                return;
            }

            return new Promise(resolve => {
                openModal(`
                    <div class="text-center">
                        <span class="px-3 py-1 rounded-full bg-red-800 text-amber-100 text-xs font-extrabold uppercase">Thẻ Biến Động Thị Trường (!)</span>
                        <div class="text-6xl my-4">${card.icon}</div>
