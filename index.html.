<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Du Ký Làng Nghề - Sa Bàn 3D Bản Đồ Di Sản Việt Nam</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js r128 & OrbitControls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <!-- GSAP for smooth 3D animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,700;0,800;1,600&display=swap" rel="stylesheet">

    <style>
        :root {
            --kraft-bg: #f3e9d2;
            --kraft-dark: #d8c39e;
            --wood-brown: #5c3a21;
            --wood-dark: #3b2313;
            --lacquer-red: #9e2a2b;
            --lacquer-gold: #e09f3e;
            --jade-green: #2a6f4e;
        }

        * {
            user-select: none;
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Be Vietnam Pro', sans-serif;
            background-color: #0f171e;
            color: #2c1d11;
        }

        .font-serif-vn {
            font-family: 'Playfair Display', serif;
        }

        /* Kraft Paper & FSC Recycled Texture Effect */
        .kraft-card {
            background-color: #f6eedc;
            background-image: 
                radial-gradient(rgba(139, 90, 43, 0.06) 1px, transparent 0),
                radial-gradient(rgba(92, 58, 33, 0.04) 1px, transparent 0);
            background-size: 24px 24px;
            background-position: 0 0, 12px 12px;
            border: 2px solid #c8ad7f;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 30, 0.55), inset 0 0 18px rgba(166, 124, 82, 0.18);
        }

        .wood-panel {
            background: linear-gradient(145deg, rgba(68, 40, 20, 0.95), rgba(40, 22, 10, 0.96));
            border: 2px solid #a47545;
            box-shadow: 0 8px 20px rgba(0,0,0,0.65), inset 0 1px 1px rgba(255,235,200,0.22);
            color: #f7ebd4;
            backdrop-filter: blur(6px);
        }

        .wood-btn {
            background: linear-gradient(180deg, #b8332a 0%, #7d1d16 100%);
            border: 2px solid #f2c166;
            color: #fff8eb;
            text-shadow: 0 1px 2px rgba(0,0,0,0.6);
            box-shadow: 0 4px 0 #4d0e0a, 0 8px 15px rgba(0,0,0,0.4);
            transition: all 0.15s ease;
        }

        .wood-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 0 #4d0e0a, 0 12px 20px rgba(0,0,0,0.5);
            filter: brightness(1.08);
        }

        .wood-btn:active:not(:disabled) {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #4d0e0a, 0 4px 8px rgba(0,0,0,0.4);
        }

        .wood-btn:disabled {
            background: linear-gradient(180deg, #786b5e 0%, #52473d 100%);
            border-color: #9c8c7c;
            box-shadow: 0 3px 0 #332c25;
            cursor: not-allowed;
            opacity: 0.7;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(60, 36, 21, 0.2);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #8c6239;
            border-radius: 8px;
        }

        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(224, 159, 62, 0.7), 0 0 15px rgba(224, 159, 62, 0.5); }
            50% { box-shadow: 0 0 0 6px rgba(224, 159, 62, 0), 0 0 25px rgba(224, 159, 62, 0.9); }
        }

        .active-turn-glow {
            animation: pulseGlow 2s infinite;
            border-color: #fbbf24 !important;
        }

        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .hud-layer {
            position: relative;
            z-index: 10;
            pointer-events: none;
        }

        .hud-interactive {
            pointer-events: auto;
        }

        /* Collapsible Panel Transitions */
        .collapsible-panel {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .panel-collapsed-left {
            transform: translateX(calc(-100% + 44px));
        }
        .panel-collapsed-right {
            transform: translateX(calc(100% - 44px));
        }
        .panel-collapsed-bottom {
            transform: translateY(calc(100% - 42px));
        }
        .glass-pill {
            background: rgba(34, 20, 10, 0.85);
            border: 1.5px solid rgba(224, 159, 62, 0.6);
            backdrop-filter: blur(10px);
            color: #fef3c7;
        }

        /* Floating 3D Hover Tooltip */
        #tile-hover-tooltip {
            position: fixed;
            z-index: 40;
            pointer-events: none;
            transition: opacity 0.12s ease, transform 0.12s ease;
            transform: translate(-50%, -115%);
        }

        /* Floating Cash Change Animation */
        @keyframes floatUpFade {
            0% { opacity: 1; transform: translateY(0) scale(0.9); }
            30% { opacity: 1; transform: translateY(-10px) scale(1.05); }
            100% { opacity: 0; transform: translateY(-28px) scale(0.95); }
        }
        .cash-delta-badge {
            animation: floatUpFade 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Custom Keycap Hint */
        .kbd-hint {
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(251, 191, 36, 0.45);
            border-bottom-width: 2px;
            border-radius: 4px;
            padding: 1px 5px;
            font-size: 9px;
            font-family: monospace;
            color: #fde68a;
        }
    </style>
</head>
<body class="relative w-screen h-screen overflow-hidden select-none">

    <!-- 3D WebGL Canvas Container -->
    <div id="canvas-container"></div>

    <!-- Interactive 3D Hover Tooltip (Appears when hovering any 3D Tile on Map) -->
    <div id="tile-hover-tooltip" class="opacity-0 hidden">
        <div class="glass-pill px-3 py-2 rounded-2xl shadow-2xl border border-amber-400/70 min-w-[180px]">
            <div class="flex items-center justify-between gap-2 border-b border-amber-500/30 pb-1 mb-1">
                <span id="tt-badge" class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-amber-600 text-amber-950">#0 • Hà Nội</span>
                <span id="tt-owner" class="text-[9px] font-bold text-emerald-300">Chưa có chủ</span>
            </div>
            <div class="flex items-center gap-2">
                <span id="tt-icon" class="text-xl">🏯</span>
                <div>
                    <div id="tt-name" class="font-extrabold text-xs text-white leading-tight">Thăng Long - Hà Nội</div>
                    <div id="tt-sub" class="text-[10px] text-amber-200/90">Qua nhận +300đ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating NPC / Action Speech Bubble (Compact) -->
    <div id="action-banner" class="fixed top-16 left-1/2 -translate-x-1/2 z-30 pointer-events-none transition-all duration-300 opacity-0 scale-95">
        <div class="glass-pill px-4 py-1.5 rounded-full flex items-center gap-2 shadow-2xl">
            <span id="banner-icon" class="text-lg">🎲</span>
            <span id="banner-text" class="font-bold text-amber-200 text-xs md:text-sm tracking-wide">Đang khởi tạo sa bàn 3D...</span>
        </div>
    </div>

    <!-- Market Status Buff Bar (Biến động thị trường) -->
    <div id="market-buff-bar" class="fixed top-14 right-4 z-20 flex flex-col gap-1 pointer-events-none"></div>

    <!-- MAIN HUD OVERLAY -->
    <div class="hud-layer w-full h-full flex flex-col justify-between p-2 md:p-3">

        <!-- TOP HEADER BAR (ERGONOMIC, UNIFIED & ULTRA-CLEAN) -->
        <header class="w-full flex flex-wrap items-center justify-between gap-1.5">
            <!-- Left: Brand & 32-Tile Quick Directory -->
            <div class="flex items-center gap-1.5 hud-interactive">
                <div class="wood-panel px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-lg">
                    <div class="w-7 h-7 rounded-lg bg-amber-500/25 border border-amber-400/60 flex items-center justify-center text-amber-300 text-sm shadow-inner">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h1 class="font-serif-vn font-extrabold text-xs md:text-sm text-amber-300 tracking-wider">DU KÝ LÀNG NGHỀ 3D</h1>
                            <button onclick="openDirectoryModal()" class="text-[10px] bg-emerald-700 hover:bg-emerald-600 text-emerald-100 border border-emerald-400/50 px-2 py-0.5 rounded-full font-bold transition flex items-center gap-1 shadow" title="Mở danh sách 32 Địa Danh để phóng Camera đến xem ngay">
                                <i class="fa-solid fa-compass"></i> 32 Địa Danh
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Center: Round, Cashier, Timer & Speed Control Pill -->
            <div class="wood-panel hud-interactive px-3 py-1 rounded-xl flex items-center gap-2.5 text-xs shadow-lg">
                <div class="flex items-center gap-1" title="Vòng đi hiện tại trên bản đồ">
                    <i class="fa-solid fa-rotate text-amber-400"></i>
                    <span class="text-amber-200/80 hidden sm:inline">Vòng:</span>
                    <span id="round-counter" class="font-extrabold text-white">1</span>
                </div>
                <div class="h-3.5 w-[1px] bg-amber-700/60"></div>
                <div class="flex items-center gap-1" title="Người chơi luân phiên làm Thủ quỹ Ngân hàng mỗi vòng">
                    <i class="fa-solid fa-scale-balanced text-amber-400"></i>
                    <span class="text-amber-200/80 hidden md:inline">Thủ quỹ:</span>
                    <span id="cashier-name" class="font-bold text-amber-300 bg-amber-950/80 px-1.5 py-0.5 rounded border border-amber-600/50">Quốc Anh</span>
                </div>
                <div class="h-3.5 w-[1px] bg-amber-700/60"></div>
                <div class="flex items-center gap-1" title="Thời gian còn lại của ván chơi">
                    <i class="fa-regular fa-clock text-amber-400"></i>
                    <span id="game-timer" class="font-mono font-bold text-amber-300">45:00</span><span class="text-[10px] text-amber-200 ml-2" title="Thắng ngay: đạt 2500đ tài sản HOẶC độc quyền 2 ngành nghề">🎯 2500đ | 2 ngành</span>
                </div>
                <div class="h-3.5 w-[1px] bg-amber-700/60"></div>
                <button onclick="toggleGameSpeed()" class="bg-amber-800/80 hover:bg-amber-700 text-amber-200 border border-amber-500/40 px-2 py-0.5 rounded-lg font-extrabold text-[10px] transition flex items-center gap-1" title="Tăng tốc độ di chuyển và suy nghĩ của NPC">
                    <i class="fa-solid fa-bolt text-amber-400"></i>
                    <span id="speed-label">Tốc độ: 1x</span>
                </button>
            </div>

            <!-- Right: Streamlined Audio, Camera & Game Mode Controls -->
            <div class="flex flex-wrap items-center gap-1 hud-interactive">
                <div class="wood-panel px-2 py-1 rounded-xl flex items-center gap-1 text-xs">
                    <button id="btn-audio" onclick="toggleAudio()" class="hover:text-amber-300 transition flex items-center gap-1 font-semibold px-1" title="Bật/Tắt Nhạc Nền">
                        <i id="audio-icon" class="fa-solid fa-volume-xmark text-amber-300/70"></i>
                        <span class="hidden 2xl:inline text-[10px]" id="audio-label">Thịnh Vượng VN</span>
                    </button>
                    <button onclick="switchMusicStyle()" class="text-[10px] bg-amber-600 hover:bg-amber-500 text-amber-950 px-1.5 py-0.5 rounded font-extrabold shadow" title="Đổi giữa bài Thịnh Vượng Việt Nam Sáng Ngời & Nghề Xưa Hồn Nay">
                        <i class="fa-solid fa-repeat"></i> <span class="hidden sm:inline">Đổi Bài</span>
                    </button>
                    <label class="text-[10px] bg-emerald-600 hover:bg-emerald-500 px-1.5 py-0.5 rounded text-white cursor-pointer font-extrabold flex items-center gap-1 shadow" title="Chọn 2 file Video MP4 gốc từ máy để phát 100% âm thanh gốc">
                        <i class="fa-solid fa-file-video"></i>
                        <span class="hidden md:inline">Nạp Video</span>
                        <input type="file" accept="audio/*,video/*" multiple class="hidden" onchange="handleCustomAudioUpload(event)">
                    </label>
                </div>

                <div class="wood-panel px-1.5 py-1 rounded-xl flex items-center gap-1 text-xs">
                    <button onclick="toggleAutoFollowCamera()" id="btn-autofollow" class="px-2 py-0.5 rounded-lg bg-emerald-800/80 text-emerald-200 border border-emerald-500/40 hover:bg-emerald-700 transition flex items-center gap-1 text-[10px] font-bold" title="Tự động lia Camera theo bước chân quân cờ (Phím F)">
                        <i class="fa-solid fa-location-crosshairs"></i>
                        <span class="hidden xl:inline" id="autofollow-label">Theo Quân: Bật</span>
                    </button>
                    <button onclick="cycleCameraPreset()" class="px-2 py-0.5 rounded-lg hover:bg-amber-800/60 transition flex items-center gap-1 text-[10px] font-semibold text-amber-200" title="Chuyển góc nhìn Camera (Phím C)">
                        <i class="fa-solid fa-video text-amber-400"></i>
                        <span id="cam-mode-label">Toàn Cảnh</span>
                    </button>
                    <button onclick="toggle3DLabels()" class="px-1.5 py-0.5 rounded-lg hover:bg-amber-800/60 transition text-[10px] font-semibold text-amber-200" title="Ẩn/Hiện nhãn tên trên bản đồ 3D">
                        <i class="fa-solid fa-tags text-amber-400"></i>
                        <span class="hidden xl:inline" id="label-toggle-text">Nhãn</span>
                    </button>
                    <button onclick="toggleCleanMapMode()" class="px-1.5 py-0.5 rounded-lg hover:bg-amber-800/60 transition text-[10px] font-semibold text-emerald-300" title="Thu gọn giao diện để ngắm trọn bản đồ 3D (Phím H)">
                        <i id="clean-map-icon" class="fa-solid fa-eye"></i>
                    </button>
                </div>

                <button onclick="surrenderCurrent()" class="wood-panel px-2.5 py-1.5 rounded-xl hover:bg-red-900/60 transition text-xs font-semibold" title="Đầu hàng / Tuyên bố phá sản">🏳️ Đầu hàng</button>
                <button onclick="openCostumeModal()" class="wood-panel px-2.5 py-1.5 rounded-xl hover:bg-amber-900/60 transition flex items-center gap-1 text-xs font-semibold" title="Chế Độ Chơi (1-5 Người), Đổi Cổ Phục & Nhân Vật">
                    <i class="fa-solid fa-users-gear text-amber-300"></i>
                    <span class="hidden lg:inline text-[11px]">5 Người</span>
                </button>

                <button onclick="openRulesModal()" class="bg-emerald-700 hover:bg-emerald-600 text-amber-100 border border-emerald-400 px-2.5 py-1.5 rounded-xl shadow transition flex items-center gap-1 text-xs font-extrabold" title="Xem Hướng Dẫn Chơi Chi Tiết">
                    <i class="fa-solid fa-circle-question text-amber-300"></i>
                    <span class="hidden sm:inline">Luật Chơi</span>
                </button>

                <button onclick="finishGameAndAudit('Kết thúc sớm để kiểm kê tài sản')" class="bg-amber-600 hover:bg-amber-500 text-amber-950 font-extrabold px-2.5 py-1.5 rounded-xl border border-amber-300 shadow transition flex items-center gap-1 text-xs" title="Kết thúc ván và tổng kết xếp hạng tài sản">
                    <i class="fa-solid fa-trophy"></i>
                    <span class="hidden sm:inline">Kiểm Kê</span>
                </button>
            </div>
        </header>

        <!-- MIDDLE SECTION: COLLAPSIBLE LEFT PLAYER DRAWER & COLLAPSIBLE RIGHT INSPECTOR/LOG -->
        <div class="flex-1 flex justify-between items-start my-1.5 pointer-events-none overflow-hidden relative">
            
            <!-- Left Column: Collapsible 5 Players Status Drawer (Click any player to focus 3D Camera) -->
            <div id="left-drawer" class="collapsible-panel hud-interactive flex items-start">
                <div class="wood-panel p-2 rounded-2xl w-56 md:w-64 shadow-2xl border border-amber-700/60">
                    <div class="flex items-center justify-between border-b border-amber-700/40 pb-1 mb-1.5 px-1">
                        <span class="text-[11px] font-bold text-amber-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-users"></i> <span id="active-player-count-label">5 Thương Khách</span>
                            <span class="text-[9px] text-amber-200/60 font-normal">(Click để định vị)</span>
                        </span>
                        <button onclick="togglePanel('left-drawer')" class="text-amber-300 hover:text-white text-xs px-1" title="Thu gọn bảng người chơi">
                            <i class="fa-solid fa-angles-left"></i>
                        </button>
                    </div>
                    <div id="players-panel" class="flex flex-col gap-1.5 max-h-[60vh] overflow-y-auto pr-0.5">
                        <!-- Populated dynamically by JS -->
                    </div>
                </div>
                <!-- Tab handle visible when collapsed -->
                <button id="left-drawer-handle" onclick="togglePanel('left-drawer')" class="hidden wood-panel ml-1 px-2.5 py-3 rounded-r-xl text-amber-300 hover:text-white shadow-lg flex-col items-center gap-1 text-xs font-bold" title="Mở bảng Thương Khách">
                    <i class="fa-solid fa-users"></i>
                    <i class="fa-solid fa-angles-right text-[10px]"></i>
                </button>
            </div>

            <!-- Right Column: Collapsible Tile Detail + Collapsible Journey Log -->
            <div id="right-drawer" class="collapsible-panel flex flex-col gap-1.5 w-60 md:w-72 items-end">
                
                <!-- Tile Inspector Card (Collapsible) -->
                <div id="tile-inspector" class="kraft-card hud-interactive w-full p-2.5 rounded-2xl transition-all duration-200">
                    <div class="flex items-center justify-between border-b border-amber-800/20 pb-1 mb-1.5">
                        <span id="insp-badge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-amber-800 text-amber-100">Ô #0 • Hà Nội</span>
                        <div class="flex items-center gap-1">
                            <button onclick="navigateInspectorTile(-1)" class="text-[10px] bg-amber-900/10 hover:bg-amber-900/25 text-amber-950 px-1.5 py-0.5 rounded transition" title="Ô trước đó">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <button onclick="navigateInspectorTile(1)" class="text-[10px] bg-amber-900/10 hover:bg-amber-900/25 text-amber-950 px-1.5 py-0.5 rounded transition" title="Ô tiếp theo">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                            <button onclick="focusCameraOnSelectedTile()" class="text-[10px] bg-amber-800 hover:bg-amber-700 text-amber-100 font-bold px-2 py-0.5 rounded-lg transition shadow-sm" title="Phóng to Camera vào mô hình 3D này">
                                <i class="fa-solid fa-magnifying-glass-plus"></i> Soi 3D
                            </button>
                            <button onclick="toggleElementBody('insp-body-wrap', 'insp-toggle-icon')" class="text-amber-900 hover:text-amber-700 px-1 text-xs" title="Thu gọn/Mở rộng chi tiết ô">
                                <i id="insp-toggle-icon" class="fa-solid fa-chevron-up"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex gap-2 items-center">
                        <canvas id="insp-Disconnect-canvas" width="64" height="64" class="w-11 h-11 rounded-xl border border-amber-700/40 bg-amber-100 shrink-0 shadow-sm"></canvas>
                        <div class="flex-1 min-w-0">
                            <h3 id="insp-title" class="font-bold text-xs md:text-sm text-amber-950 truncate">Thăng Long - Hà Nội</h3>
                            <p id="insp-desc" class="text-[10px] text-amber-900/85 line-clamp-1 leading-tight">Khuê Văn Các • Qua nhận +300đ</p>
                        </div>
                    </div>

                    <div id="insp-body-wrap" class="mt-1.5">
                        <div id="insp-stats" class="hidden pt-1.5 border-t border-amber-800/20 text-[10px] space-y-0.5">
                            <div class="flex justify-between">
                                <span class="text-amber-900/70">Giá mua / Phí:</span>
                                <span><b id="insp-price" class="text-emerald-800">120đ</b> / <b id="insp-rent" class="text-red-700">60đ</b></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-amber-900/70">Công cụ miễn phí:</span>
                                <span id="insp-tool" class="font-bold text-amber-900 truncate max-w-[135px]">Đất sét & Bàn xoay</span>
                            </div>
                            <div class="text-[10px] italic text-amber-950 bg-amber-500/15 p-1.5 rounded-lg mt-1 leading-snug" id="insp-situation">
                                "Khách vãng lai phải tự tay chuốt một bình gốm."
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scrollable Journey Log (Collapsible - Compact by default) -->
                <div class="wood-panel hud-interactive w-full p-2.5 rounded-2xl flex flex-col">
                    <div class="flex items-center justify-between cursor-pointer" onclick="toggleElementBody('log-body-wrap', 'log-toggle-icon')">
                        <span class="text-[11px] font-bold text-amber-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-scroll"></i> Nhật Ký Hành Trình
                        </span>
                        <button class="text-amber-300 hover:text-white text-xs px-1" title="Thu gọn/Mở rộng Nhật ký">
                            <i id="log-toggle-icon" class="fa-solid fa-chevron-up"></i>
                        </button>
                    </div>
                    <div id="log-body-wrap" class="mt-1.5 pt-1.5 border-t border-amber-700/40">
                        <div id="game-log" class="h-24 md:h-28 overflow-y-auto space-y-1 pr-1 text-[10px] leading-snug">
                            <!-- Log entries injected here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM CONTROL BAR: COMPACT COLLAPSIBLE HAND & ERGONOMIC DICE DOCK -->
        <footer class="w-full flex flex-col sm:flex-row items-end sm:items-center justify-between gap-2">
            
