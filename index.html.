        // Point-in-polygon helper (2D Lon/Lat)
        function isPointInPolygon(lon, lat, polygon) {
            let inside = false;
            for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
                const xi = polygon[i][0], yi = polygon[i][1];
                const xj = polygon[j][0], yj = polygon[j][1];
                const intersect = ((yi > lat) !== (yj > lat)) &&
                    (lon < (xj - xi) * (lat - yi) / (yj - yi + 1e-9) + xi);
                if (intersect) inside = !inside;
            }
            return inside;
        }

        // Authentic Topographic Elevation Function (DEM) of Vietnam matching the Reference Shaded-Relief Image
        function sampleVietnamElevation(lon, lat) {
            let h = 0.08; // Base alluvial plain elevation (Red River Delta & Mekong Delta)

            // 1. Tây Bắc & Hoàng Liên Sơn (Fansipan, Lào Cai, Lai Châu, Điện Biên, Hà Giang) - High ochre-brown peaks
            const dTayBac = Math.hypot((lon - 103.7) * 1.1, (lat - 22.1));
            if (dTayBac < 2.6) {
                h += Math.pow(1 - dTayBac / 2.6, 1.6) * 1.65;
            }

            // 2. Cao nguyên đá Đồng Văn - Hà Giang & Cao Bằng (Đông Bắc)
            const dDongBac = Math.hypot((lon - 105.6), (lat - 22.8));
            if (dDongBac < 2.0) {
                h += Math.pow(1 - dDongBac / 2.0, 1.5) * 1.25;
            }

            // 3. Red River Delta (Đồng bằng Sông Hồng: Hà Nội, Bắc Ninh, Hưng Yên, Thái Bình, Nam Định) -> Keep flat lush green!
            const dRedRiver = Math.hypot((lon - 106.05) * 1.2, (lat - 20.75) * 1.3);
            if (dRedRiver < 1.35) {
                h *= 0.25;
            }

            // 4. Bắc Trường Sơn (Western Thanh Hóa, Nghệ An, Hà Tĩnh, Quảng Bình, Huế)
            const truongSonLon = 104.8 + (19.5 - lat) * 0.42;
            if (lat >= 15.2 && lat <= 20.2) {
                const distTS = Math.abs(lon - truongSonLon);
                if (distTS < 1.3) {
                    h += Math.pow(1 - distTS / 1.3, 1.6) * 1.18;
                }
            }

            // 5. Nam Trường Sơn & Tây Nguyên (Kon Tum, Gia Lai, Đắk Lắk, Đắk Nông, Lâm Viên Đà Lạt) - High Ochre Plateau
            const dTayNguyen = Math.hypot((lon - 108.15) * 1.25, (lat - 13.2) * 0.62);
            if (dTayNguyen < 2.4) {
                h += Math.pow(1 - dTayNguyen / 2.4, 1.45) * 1.55;
            }

            // Extra peak at Lâm Viên - Đà Lạt (Langbiang)
            const dDaLat = Math.hypot((lon - 108.45), (lat - 11.95));
            if (dDaLat < 1.15) {
                h += Math.pow(1 - dDaLat / 1.15, 1.5) * 0.75;
            }

            // 6. Mekong Delta & Southern Plains (Đồng bằng Sông Cửu Long & TP.HCM) -> Flat emerald plain
            if (lat < 11.2) {
                h = Math.min(h, 0.14);
            }

            // Micro-ridge ruggedness (realistic mountain valleys & ridges like the reference image)
            const ridgeNoise =
                Math.sin(lon * 18.0 + lat * 14.0) * 0.14 +
                Math.cos(lon * 37.0 - lat * 29.0) * 0.08 +
                Math.sin(lon * 65.0 + lat * 52.0) * 0.04;

            if (h > 0.22) {
                h += Math.abs(ridgeNoise) * (h * 0.75);
            }

            return Math.max(0.06, h);
        }

        // High-Resolution Shaded-Relief Texture Generator (Matches the exact Green-Yellow-Ochre-Brown Hypsometric Tint + NW Hillshade of the user's image!)
        function createAuthenticShadedReliefTexture() {
            const w = 1024, h = 1536;
            const c = document.createElement('canvas');
            c.width = w;
            c.height = h;
            const ctx = c.getContext('2d');
            const imgData = ctx.createImageData(w, h);
            const data = imgData.data;

            const lonMin = 101.5, lonMax = 110.2;
            const latMin = 8.2, latMax = 23.8;

            for (let py = 0; py < h; py++) {
                const lat = latMax - (py / h) * (latMax - latMin);
                for (let px = 0; px < w; px++) {
                    const lon = lonMin + (px / w) * (lonMax - lonMin);
                    const elev = sampleVietnamElevation(lon, lat);

                    // Finite-difference slope for crisp Northwest Hillshading
                    const eRight = sampleVietnamElevation(lon + 0.03, lat);
                    const eDown = sampleVietnamElevation(lon, lat - 0.03);
                    const dx = (eRight - elev) * 18.0;
                    const dy = (eDown - elev) * 18.0;
                    const hillshade = Math.max(0.62, Math.min(1.38, 1.05 - dx * 0.78 + dy * 0.65));

                    // Pure Lush Emerald-Jade-Forest Green Topographic Palette (Đổi hoàn toàn sang tông Xanh Lá Tươi Mát):
                    // Lowland Deltas (ĐB Sông Hồng & ĐBSCL): Fresh Spring Lime-Emerald (#4ade80 -> #22c55e)
                    // Midland Hills (Trung du): Vibrant Jade-Emerald (#16a34a -> #15803d)
                    // Highlands (Tây Nguyên & Trường Sơn): Deep Tropical Rainforest Green (#15803d -> #166534)
                    // High Peaks (Hoàng Liên Sơn): Majestic Pine-Viridian with Emerald Mist (#065f46 -> #10b981)
                    let r, g, b;
                    if (elev < 0.22) {
                        const t = elev / 0.22;
                        r = 68 - t * 30;
                        g = 222 - t * 18;
                        b = 122 - t * 24;
                    } else if (elev < 0.65) {
                        const t = (elev - 0.22) / 0.43;
                        r = 38 - t * 16;
                        g = 204 - t * 38;
                        b = 98 - t * 22;
                    } else if (elev < 1.25) {
                        const t = (elev - 0.65) / 0.6;
                        r = 22 - t * 6;
                        g = 166 - t * 36;
                        b = 76 - t * 12;
                    } else {
                        const t = Math.min(1, (elev - 1.25) / 0.8);
                        r = 16 + t * 28;
                        g = 130 + t * 35;
                        b = 64 + t * 38;
                    }

                    const idx = (py * w + px) * 4;
                    data[idx] = Math.min(255, Math.max(0, r * hillshade));
                    data[idx + 1] = Math.min(255, Math.max(0, g * hillshade));
                    data[idx + 2] = Math.min(255, Math.max(0, b * hillshade));
                    data[idx + 3] = 255;
                }
            }
            ctx.putImageData(imgData, 0, 0);

            // Overlay Major River Networks in Vivid Cyan-Turquoise (Sông Hồng, Sông Đà, Sông Tiền, Sông Hậu)
            const drawGeoRiver = (coords, width) => {
                ctx.strokeStyle = '#00e5ff';
                ctx.lineWidth = width;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.beginPath();
                coords.forEach(([lon, lat], i) => {
                    const rx = ((lon - lonMin) / (lonMax - lonMin)) * w;
                    const ry = ((latMax - lat) / (latMax - latMin)) * h;
                    if (i === 0) ctx.moveTo(rx, ry);
                    else ctx.lineTo(rx, ry);
                });
                ctx.stroke();
            };

            // Sông Hồng & Sông Đà
            drawGeoRiver([[103.8, 22.6], [104.8, 21.7], [105.4, 21.3], [105.85, 21.05], [106.1, 20.6], [106.55, 20.25]], 6);
            drawGeoRiver([[103.1, 22.1], [103.9, 21.3], [104.7, 20.8], [105.3, 21.25]], 5);
            // Sông Tiền & Sông Hậu (Mekong Delta)
            drawGeoRiver([[105.1, 10.85], [105.6, 10.45], [106.15, 10.28], [106.7, 10.05]], 7);
            drawGeoRiver([[105.08, 10.75], [105.45, 10.3], [105.8, 10.0], [106.25, 9.55]], 7);

            return new THREE.CanvasTexture(c);
        }

        // Build the True 3D Topographic Map of Vietnam with 3D Displaced Relief, Crisp White Border Line & Neighboring Terrain Context
        function build3DVietnamMapTerrain() {
            // Note: In Three.js ExtrudeGeometry, rotating X by -PI/2 maps shape(x, y) to 3D (x, 0, -y).
            // Therefore, to keep North at negative Z and South at positive Z without mirroring, we pass (x, -z) into THREE.Shape!
            const vnShape = new THREE.Shape();
            VIETNAM_BORDER_LONLAT.forEach(([lon, lat], idx) => {
                const { x, z } = geoToBoardXZ(lon, lat);
                if (idx === 0) vnShape.moveTo(x, -z);
                else vnShape.lineTo(x, -z);
            });
            vnShape.closePath();

            // 1. Coastal Cliff Bevel Base (Vibrant Emerald-Jade Cliff)
            const baseGeo = new THREE.ExtrudeGeometry(vnShape, {
                depth: 0.34,
                bevelEnabled: true,
                bevelSegments: 4,
                steps: 1,
                bevelSize: 0.16,
                bevelThickness: 0.14
            });
            baseGeo.rotateX(-Math.PI / 2);

            const baseMat = new THREE.MeshStandardMaterial({
                color: 0x059669,
                roughness: 0.55,
                metalness: 0.08
            });
            const baseMesh = new THREE.Mesh(baseGeo, baseMat);
            baseMesh.position.y = 0.02;
            baseMesh.receiveShadow = true;
            baseMesh.castShadow = true;
            scene.add(baseMesh);

            // 2. High-Resolution 3D Vertex-Displaced Relief Mesh inside Vietnam's Exact Silhouette
            const reliefTex = createAuthenticShadedReliefTexture();
            const lonMin = 101.5, lonMax = 110.2;
            const latMin = 8.2, latMax = 23.8;

            const gridX = 260, gridZ = 400;
            const width3D = (lonMax - lonMin) * 2.55;
            const depth3D = (latMax - latMin) * 2.75;
            const centerXZ = geoToBoardXZ((lonMin + lonMax) / 2, (latMin + latMax) / 2);

            const demGeo = new THREE.PlaneGeometry(width3D, depth3D, gridX, gridZ);
            demGeo.rotateX(-Math.PI / 2);

            const posAttr = demGeo.attributes.position;
            for (let i = 0; i < posAttr.count; i++) {
                const vx = posAttr.getX(i) + centerXZ.x;
                const vz = posAttr.getZ(i) + centerXZ.z;
                const lon = vx / 2.55 + 106.15;
                const lat = 16.0 - vz / 2.75;

                if (isPointInPolygon(lon, lat, VIETNAM_BORDER_LONLAT)) {
                    const h = sampleVietnamElevation(lon, lat);
                    posAttr.setY(i, 0.36 + h * 0.92);
                } else {
                    // Push outside-border vertices slightly below sea level so only Vietnam rises above the turquoise sea!
                    posAttr.setY(i, -0.18);
                }
            }
            demGeo.computeVertexNormals();

            const demMat = new THREE.MeshStandardMaterial({
                map: reliefTex,
                roughness: 0.76,
                metalness: 0.04
            });
            const demMesh = new THREE.Mesh(demGeo, demMat);
            demMesh.position.set(centerXZ.x, 0, centerXZ.z);
            demMesh.receiveShadow = true;
