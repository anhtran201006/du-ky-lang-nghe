        // Helper: Build Curved Vietnamese Oriental Pagoda/Communal Roof (Mái Đao Cong Truyền Thống 3D)
        function createCurvedOrientalRoof3D(width, depth, height, roofHex = 0x991b1b, ridgeHex = 0xfbbf24) {
            const roofGroup = new THREE.Group();
            const roofMat = new THREE.MeshStandardMaterial({ color: roofHex, roughness: 0.55 });
            const goldMat = new THREE.MeshStandardMaterial({ color: ridgeHex, metalness: 0.5, roughness: 0.3 });

            const cone = new THREE.Mesh(new THREE.ConeGeometry(Math.max(width, depth) * 0.72, height, 4), roofMat);
            cone.rotation.y = Math.PI / 4;
            cone.scale.set(width / Math.max(width, depth), 1, depth / Math.max(width, depth));
            cone.position.y = height / 2;
            roofGroup.add(cone);

            // 4 Upturned Dragon Eave Tips (Đầu đao cong vút ở 4 góc mái)
            [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(([sx, sz]) => {
                const eave = new THREE.Mesh(new THREE.ConeGeometry(0.045, 0.16, 6), goldMat);
                eave.position.set(sx * width * 0.48, 0.06, sz * depth * 0.48);
                eave.rotation.z = -sx * 0.55;
                eave.rotation.x = sz * 0.55;
                roofGroup.add(eave);
            });

            return roofGroup;
        }

        // Helper: Build 3D Tree Cluster (Pine for Đà Lạt / Tây Nguyên or Broadleaf Banyan/Palm for Villages)
        function create3DTreeCluster(x, y, z, style = 'PINE', scale = 1.0) {
